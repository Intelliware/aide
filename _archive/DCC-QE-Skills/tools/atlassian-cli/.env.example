# Jira Configuration
JIRA_URL=https://track.td.com
JIRA_EMAIL=your.email@td.com
JIRA_TOKEN=your-jira-pat-token

# Confluence Configuration (falls back to ATLASSIAN_* if not set)
CONFLUENCE_URL=https://collaborate.td.com
CONFLUENCE_TOKEN=your-confluence-pat-token

# Alternative: shared Atlassian credentials (used if service-specific vars not set)
# ATLASSIAN_URL=https://collaborate.td.com
# ATLASSIAN_TOKEN=your-pat-token

# Output directory (optional, defaults to ./cache)
# OUTPUT_DIR=./cache

