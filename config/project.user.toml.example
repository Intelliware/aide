# ─────────────────────────────────────────────────────────────────────────────
# project.user.toml — Layer 4 of the four-layer config model
#
# GITIGNORED. Personal, machine-local. Edited freely by you alone.
#
# Same schema as project.toml, but every field is optional. Use this file to
# pin personal preferences that override the team-committed project.toml on
# YOUR machine only.
#
# Typical use cases:
#   • Override knowledge_base_path because your KB clone lives elsewhere.
#   • Pin a different default_flow because you are doing brownfield work
#     while the team is in greenfield mode.
#   • Pre-answer elicitation questions you are tired of being asked.
#
# Higher-precedence than project.toml; lower-precedence than the
# customizations/<skill>.user.toml files. See SCHEMAS.md § 1.1.
#
# Path tokens: {project-root}, {framework-root}, {home}, {cwd}, {workspace}.
# ─────────────────────────────────────────────────────────────────────────────


# Override the KB path because your local clone lives in ~/work/kb.
[project.paths]
knowledge_base_path = "{home}/work/kb/knowledge-base-repo"


# You're hot-fixing in production this week, so quick-dev is your default.
[project]
default_flow = "quick-dev"


# Skip the testing-strategy question — you always want TDD on personally
# even when the team has not standardized.
[project.elicitation]
testing_strategy = "tdd-required"


# ─── [tools.<name>] — override only the local add-on path ────────────────────
# project.toml declares WHICH add-on tools the team uses; here you override
# only where YOUR clone lives, when it differs from the team default. Because
# [tools.*] is a table, unmentioned keys (cli, run_script, …) inherit from
# project.toml. See config/SCHEMAS.md § 2.6.

# [tools.atlassian]
# install_root = "{home}/dev/aide-addons/tools"


# ─── [user] — project-scoped personal preferences ────────────────────────────
# OPTIONAL. Used only when the project has adopted separation-of-duties (SoD).
# Deep-merges with framework.user.toml's [user] (which holds machine-global
# identity attributes like name, communication_language, skill_level).
#
# Project-scoped because the same person may act as different roles on
# different projects. See config/SCHEMAS.md § 2.4.

# [user]
# # The role you operate as on this project. Compared against
# # [stages.<stage>].write_role at every write boundary. Mismatch → write refused.
# role = "Developer"   # one of: BA | Architect | BSA | Developer | Tester | KB-Steward
#
# # Which registered feature you are currently working on. Only meaningful once
# # the project has opted into feature-scoped paths by creating features.toml
# # (config/SCHEMAS.md § 2.8). Must resolve to a declared [[features]].id in
# # that file — set by `select-feature`, not hand-edited. Personal and
# # project-scoped for the same reason `role` is: two people on this project
# # work different features at once, and neither's choice should affect the
# # other's. See config/SCHEMAS.md § 2.9.
# active_feature = "alert-customer"
