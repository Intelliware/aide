# ─────────────────────────────────────────────────────────────────────────────
# project.toml — Layer 3 of the four-layer config model
#
# COMMITTED. Team-edited. This is the project's super-context — the answers
# every skill on every flow can rely on without re-asking the user.
#
# This example demonstrates a multi-repo SaaS checkout product:
#   • api-orders     — order placement and lifecycle service
#   • api-billing    — payment, invoicing, refunds service
#   • web-portal     — admin and merchant-facing React app
# with a sibling Knowledge Base repository at ../knowledge-base-repo.
#
# Path tokens: {project-root}, {framework-root}, {home}, {cwd}.
# Relative paths resolve under {project-root}.
# ─────────────────────────────────────────────────────────────────────────────


# ─── [project] — identity, default flow, top-level metadata ──────────────────
[project]

# Human-readable name. Appears in headings and audit fields.
name = "Acme Checkout Platform"

# Stable short identifier. Lowercase, kebab-case, no spaces. Used as the
# merge key when this project appears in cross-project tooling.
code = "acme-checkout"

# One-line domain description. Feeds glossary disambiguation and persona
# priming (so "Order" means the right thing for this project, not a generic
# definition).
domain = "B2B SaaS checkout, billing, and refunds for marketplace merchants"

# Few-sentence project summary. Free-form Markdown allowed.
description = """
Multi-tenant checkout platform serving marketplace merchants. Provides
hosted checkout pages, recurring billing, refunds, and merchant admin
tooling. PCI-DSS Level 1 compliance is in scope.
"""

# Default flow when the orchestrator cannot infer one from context.
# Values: "greenfield" | "brownfield" | "quick-dev"
# This project is in maintenance mode, so brownfield is the default.
default_flow = "brownfield"


# ─── [project.paths] — output paths ──────────────────────────────────────────
[project.paths]

# Stage outputs. {project-root} is the directory containing this file.
# Once the project opts into feature scoping (features.toml exists), each
# stage writes everything for a feature — assembled package and working
# files — under <stage path>/<feature-id>/, so pointing a stage at another
# repository moves all of that stage's documents there. Code is unaffected:
# it goes to the repos in [[project.repos]]. See config/SCHEMAS.md § 2.8.
requirements_package    = "{project-root}/.framework-output/requirements"
design_package          = "{project-root}/.framework-output/design"
implementation_package  = "{project-root}/.framework-output/implementation"
quality_package         = "{project-root}/.framework-output/quality"

# Knowledge-base path. The KB is a SEPARATE git repository — this path
# almost always points outside {project-root}. Sibling-repo layout shown
# here; absolute paths (e.g. "/srv/kb/knowledge-base-repo") are also
# valid. If unset, KB-stage skills error early with a helpful message.
knowledge_base_path     = "{project-root}/../knowledge-base-repo"


# ─── [project.testing] — optional QE / test-artifact target ─────────────────
# If this project has a dedicated QE or test-automation repository, set
# `qe_repo` to the matching `[[project.repos]].code`. Quality-stage skills
# that create or inspect QE-owned executable test artifacts prefer this repo.
# If omitted, those skills fall back to the in-scope code repo.
[project.testing]

qe_repo = "qe-automation"


# ─── [project.glossary] — terms used across the project ──────────────────────
[project.glossary]

# Files that contribute glossary entries. Loaded in declared order; later
# files override earlier ones on identical terms.
references = [
  "{project-root}/docs/glossary.md",
  "{project-root}/../knowledge-base-repo/_meta/glossary.md",
]

# Inline entries override the reference files.
[[project.glossary.entries]]
term = "Order"
definition = "A merchant's record of a buyer purchase intent, from cart submission through fulfillment or cancellation."
aliases = ["Purchase", "Sale"]
domain_specific = true

[[project.glossary.entries]]
term = "Refund"
definition = "Any post-charge return of funds to the buyer, full or partial. Distinct from `Void` (pre-capture cancellation)."
aliases = []
domain_specific = true

[[project.glossary.entries]]
term = "Settlement"
definition = "The end-of-day batch reconciliation that moves authorized funds from the payment processor's holding account to the merchant's payout account."
domain_specific = true


# ─── [project.change_log] — release-stream changelog (CHANGELOG.md) ──────────
# Conditional. When `enabled = true`, `create-pr` step 6 appends a new
# entry to the configured CHANGELOG.md per merged PR; `start-project`
# scaffolds the file. When `enabled = false` (or this section is omitted),
# the framework treats the project as having no changelog and create-pr
# silently skips step 6.
#
# Distinct from per-package CHANGE-TRACKER.md: those are per-artifact,
# audience = SDLC participants. This is per-release-stream, audience =
# end users / downstream developers. Same canonical block underneath
# (`templates/blocks/shared/change-log.md`).
[project.change_log]

enabled              = true                    # default for greenfield; quick-dev usually false
path                 = "{project-root}/CHANGELOG.md"
versioning_strategy  = "semver"                # semver | calver | none
format               = "keep-a-changelog"      # keep-a-changelog | plain (project-block default)

# Project-level "Parts Affected" vocabulary. Populates the same-named
# table inside the canonical change-log block when rendered as the
# project-level changelog. Different from per-package vocabularies.
parts_affected_vocabulary = ["api", "ui", "auth", "data", "config", "build", "infra", "docs"]


# ─── [project.elicitation] — pre-answered decision-table questions ───────────
# Question codes match the codes used in the framework's decision tables.
# Skills consult these answers before re-prompting the user. Unknown codes
# are tolerated, so adding new questions to the framework does not break
# old project.toml files.
[project.elicitation]

compliance_regime          = "pci-dss"
team_size                  = "10-25"
user_facing                = true
deployment_model           = "saas-multi-tenant"
data_residency             = "us-eu-split"
release_cadence            = "weekly"
testing_strategy           = "tdd-required"
# Quality-stage elicitation answers. Consumed by `create-quality-package`,
# `execute-quality-increments`, `audit-quality-coverage`, and
# `review-test-failures` so they don't re-ask per invocation.
uses_test_case_increments  = true                 # opt into the TC-XXX per-test-case execution flow
test_framework             = "cucumber-junit5"    # primary test framework — values are free-form but should match a registered category
test_runner                = "maven-surefire"     # how the framework is invoked in CI
records_testability_classification = true         # render the Step 0b testability table as a visible block (false = change-tracker summary only; the gate itself always runs)
# Reverse-engineering close-out gate. Every reverse-engineer-* skill ends by asking
# the user how to attest the extraction before the KB ingests it:
#   "automated" — steps/verify.md runs the machine-checkable (Tier M) checks and
#                 issues a mechanical GO/NO-GO. Model-judgment (Tier J) checks are
#                 reported UNVERIFIED and never counted toward GO. No human sign-off.
#   "review"    — the mechanical checks run first as evidence, then
#                 review-reverse-engineering-package runs nine sub-reviews with
#                 per-verdict human acceptance and writes a readiness verdict.
# "ask" (the default) puts the choice to the user at close-out, which is the intended
# normal case — the user is the one who knows whether this extraction is load-bearing.
# Setting "review" or "automated" pre-answers it for unattended runs (CI, scheduled KB
# refresh); an unattended run left on "ask" fails fast rather than picking a mode.
re_verification_gate       = "ask"                # ask | review | automated
observability_stack        = "datadog"
identity_provider          = "auth0"
primary_database           = "postgres"
event_bus                  = "kafka"


# ─── [stages.<stage>] — separation-of-duties (SoD) layout, OPTIONAL ──────────
# SoD lets each SDLC role write to a dedicated repo (or, for planning/execution,
# to the relevant source-code repo). Adoption is per-stage: a stage adopts SoD
# only when its [stages.<stage>] entry declares `dir` or `colocate_with_source`.
# Stages without those fields continue resolving via [project.paths] exactly
# as today. Uncomment the blocks below to enable SoD for this project.
#
# Recommended layout: workspace folder (containing this file) sits alongside
# the role-restricted and source repos as siblings. `dir` values therefore use
# `../<repo>` to reach a sibling. See `_docs/sod-multi-repo-proposal.md` § 3
# for the full layout diagram, and `config/SCHEMAS.md` § 2.1 / § 5 for the
# SoD field reference.

# [project]
# # Subdirectory name under each SoD stage's host repo where artifacts land.
# # Bare relative directory name; not a path. Default: ".framework-output".
# artifact_subdir = ".framework-output"

# [stages.requirements]
# dir        = "../ba-repo"          # sibling host repo for requirements artifacts
# write_role = "BA"                  # one of: BA | Architect | BSA | Developer | Tester | KB-Steward

# [stages.design]
# dir        = "../architect-repo"
# write_role = "Architect"

# [stages.planning]
# colocate_with_source = true        # planning artifacts live inside each source repo
# write_role           = "Developer"

# [stages.execution]
# colocate_with_source = true        # execution artifacts live inside each source repo
# write_role           = "Developer"

# [stages.testing]
# # Step 8 — tester skills deferred; this entry shown for completeness.
# dir        = "../tester-repo"
# write_role = "Tester"


# ─── [[project.repos]] — multi-repo enumeration ──────────────────────────────
# Array-of-table; the merge key is `code`. Order does not matter.
# Exactly one entry MAY set primary = true; that repo becomes the project's
# "home" for ambiguous operations.

[[project.repos]]
code    = "api-orders"
name    = "Orders Service"
path    = "{project-root}/../api-orders"
role    = "api"
type    = "node-typescript-nest"
primary = true

[[project.repos]]
code = "api-billing"
name = "Billing Service"
path = "{project-root}/../api-billing"
role = "api"
type = "dotnet-8-aspnet"

[[project.repos]]
code = "web-portal"
name = "Merchant Web Portal"
path = "{project-root}/../web-portal"
role = "ui"
type = "react-vite-typescript"

[[project.repos]]
code = "qe-automation"
name = "QE Automation Suite"
path = "{project-root}/../qe-automation"
role = "test-automation"
type = "cucumber-junit5"


# ─── [tools.<name>] — add-on tool resolution, OPTIONAL ───────────────────────
# Integration tooling (JIRA/Confluence, SharePoint/doc-convert) ships as a
# separate ADD-ON REPO, not in core. A [tools.<name>] block tells a skill from
# that add-on how to locate its CLI. The team declares intent here; each person
# may override only `install_root` in project.user.toml if their add-on clone
# lives elsewhere. See config/SCHEMAS.md § 2.6.
#
# Uncomment once you have cloned the add-on repo (e.g. as a sibling folder).

# [tools.atlassian]
# cli          = "atl"                                    # probed on PATH first
# install_root = "{workspace}/aide-addons/tools"          # fallback: cd here && npm run atl --
# run_script   = "atl"
# setup_doc    = "{workspace}/aide-addons/tools/packages/atlassian-cli/SETUP-ATL-CLI.md"

# [tools.sharepoint]
# cli          = "spt"
# install_root = "{workspace}/aide-addons/tools"
# run_script   = "spt"
