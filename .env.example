# ==============================================================================
# CLI Tools Authentication Configuration - EXAMPLE
# ==============================================================================
# Copy this file to .env and replace all placeholder values with your actual credentials.
# The .env file is gitignored and will NOT be committed to version control.
# Keep your .env file secure - it contains API tokens and credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# SCRIPTING RUNTIME
# ------------------------------------------------------------------------------
# Determines which runtime to use for JSON parsing and data conversion
# Options: 'node' (recommended, required anyway) or 'python'/'python3'
SCRIPT_RUNTIME=node

# ------------------------------------------------------------------------------
# ATLASSIAN (Jira & Confluence)
# ------------------------------------------------------------------------------
# Get your API token from: https://id.atlassian.com/manage-profile/security/api-tokens
# 1. Click "Create API token"
# 2. Name it "Atlassian CLI - Tools"
# 3. Copy the token (looks like: ATATT3xFfGF0...)
# 4. Paste it below

JIRA_URL=https://your-jira.atlassian.net
JIRA_TOKEN=YOUR_JIRA_TOKEN_HERE

CONFLUENCE_URL=https://your-confluence.atlassian.net
CONFLUENCE_TOKEN=YOUR_CONFLUENCE_TOKEN_HERE

# Shared/fallback values (can be the same as JIRA_* values)
ATLASSIAN_URL=https://your-jira.atlassian.net
ATLASSIAN_TOKEN=YOUR_JIRA_TOKEN_HERE

# Note: You can use the same token for both Jira and Confluence

# ------------------------------------------------------------------------------
# SHAREPOINT (TD Internal)
# ------------------------------------------------------------------------------
# For TD Internal SharePoint (myteam.td.com)
# On Windows: Uses integrated authentication automatically (no config needed)
# On macOS/Linux: Would require manual credentials (not typically used)

# For Microsoft 365 SharePoint only (*.sharepoint.com):
# SHAREPOINT_M365_TOKEN=YOUR_M365_BEARER_TOKEN_HERE

# ------------------------------------------------------------------------------
# OPTIONAL: Logging Configuration
# ------------------------------------------------------------------------------
# Set to 'true' to enable detailed API logging (saves to _logs_/)
# API_LOGGING=false

# Optional: Log Level
# Options: error, warn, info, http, debug
# LOG_LEVEL=info

# ==============================================================================
# SETUP INSTRUCTIONS
# ==============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Replace all YOUR_*_HERE placeholders with your actual credentials
#
# 3. Test authentication:
#    cd tools
#    npm run atl -- auth status
#    npm run spt -- status
# ==============================================================================
