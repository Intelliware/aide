# SharePoint CLI Configuration

# Microsoft 365 SharePoint - Bearer Token Authentication
SHAREPOINT_API_TOKEN=

# TD Internal SharePoint - Windows Authentication (NTLM)
WINDOWS_USERNAME=
WINDOWS_PASSWORD=
WINDOWS_DOMAIN=TD

# Logging Configuration
LOG_LEVEL=info

# Optional: Proxy Configuration (uncomment if needed)
# HTTP_PROXY=
# HTTPS_PROXY=
