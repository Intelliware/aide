# Atlassian CLI Configuration

# Scripting Runtime for JSON parsing and data conversion
# Options: node, python, python3
# Recommendation: Use 'node' (required for CLI anyway)
SCRIPT_RUNTIME=node

# Jira Configuration
JIRA_URL=https://track.td.com
JIRA_EMAIL=your.email@example.com
JIRA_TOKEN=your-jira-personal-access-token

# Confluence Configuration
CONFLUENCE_URL=https://collaborate.td.com
CONFLUENCE_EMAIL=your.email@example.com
CONFLUENCE_TOKEN=your-confluence-personal-access-token

# Optional: Combined URL (if both services share the same base)
# ATLASSIAN_URL=https://your-company.atlassian.net

# Logging Configuration
LOG_LEVEL=info

# Optional: Proxy Configuration (uncomment if needed)
# HTTP_PROXY=
# HTTPS_PROXY=
