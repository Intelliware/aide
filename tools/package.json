{
  "name": "ea-workspace-tools",
  "version": "1.0.0",
  "private": true,
  "description": "EasyApply Workspace CLI Tools - Monorepo for Atlassian and SharePoint integrations",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install-all": "npm install",
    "link-all": "npm run link --workspaces",
    "unlink-all": "npm run unlink --workspaces",
    "atl": "node packages/atlassian-cli/bin/atl.js",
    "spt": "node packages/sharepoint-cli/bin/spt.js",
    "req-extract": "node scripts/organize-requirements-package.js",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "clean": "rm -rf node_modules packages/*/node_modules",
    "setup": "npm install"
  },
  "keywords": [
    "atlassian",
    "jira",
    "confluence",
    "sharepoint",
    "cli",
    "workspace",
    "tools"
  ],
  "author": "EasyApply Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "axios-ntlm": "^1.4.6",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "conf": "^12.0.0",
    "dotenv": "^17.4.1",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "turndown": "^7.1.2",
    "winston": "^3.11.0"
  }
}